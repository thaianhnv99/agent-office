#!/usr/bin/env bash
# Runs a pinned gitleaks from .cache/, downloading it once and verifying its checksum, so neither
# this machine nor CI installs it system-wide (plan §9.2; no Homebrew).
#
#   ./scripts/gitleaks git --redact --verbose .   # scan every commit in history
#
# Run the history scan before the first public push: once a commit is public it cannot be recalled.
set -euo pipefail

version="8.30.1"
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Checksums from gitleaks_${version}_checksums.txt of the GitHub release.
case "$(uname -s)-$(uname -m)" in
  Darwin-arm64)  asset="darwin_arm64"; sha256="b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5" ;;
  Darwin-x86_64) asset="darwin_x64";   sha256="dfe101a4db2255fc85120ac7f3d25e4342c3c20cf749f2c20a18081af1952709" ;;
  Linux-x86_64)  asset="linux_x64";    sha256="551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb" ;;
  Linux-aarch64) asset="linux_arm64";  sha256="e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080" ;;
  *) echo "scripts/gitleaks: unsupported platform $(uname -s)-$(uname -m)" >&2; exit 2 ;;
esac

dir="$root/.cache/gitleaks/$version"
bin="$dir/gitleaks"

if [ ! -x "$bin" ]; then
  mkdir -p "$dir"
  archive="$(mktemp "$dir/download.XXXXXX")"
  trap 'rm -f "$archive"' EXIT
  curl -fsSL "https://github.com/gitleaks/gitleaks/releases/download/v${version}/gitleaks_${version}_${asset}.tar.gz" -o "$archive"
  if ! echo "$sha256  $archive" | shasum -a 256 -c - >/dev/null; then
    echo "scripts/gitleaks: checksum mismatch for gitleaks ${version} (${asset}); refusing to run it" >&2
    exit 1
  fi
  tar -xzf "$archive" -C "$dir" gitleaks
fi

exec "$bin" "$@"
